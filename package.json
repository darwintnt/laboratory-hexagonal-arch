{
    "name": "desktop",
    "version": "1.0.0",
    "description": "",
    "main": "src/index.ts",
    "scripts": {
        "dev": "tsx --watch src/index.ts",
        "build": "tsc",
        "start": "tsc && node dist/index.js",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "prisma:generate": "pnpm dlx prisma generate --schema=src/infrastructure/models/schema.prisma",
        "prisma:migrate": "pnpm dlx prisma migrate dev --schema=src/infrastructure/models/schema.prisma --config=src/infrastructure/config/prisma.config.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.1.1",
            "onFail": "download"
        }
    },
    "type": "module",
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "pg": "^8.21.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.2",
        "@types/pg": "^8.20.0",
        "nodemon": "^3.1.14",
        "prettier": "3.8.3",
        "prisma": "^7.8.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3"
    },
    "prisma": {
        "schema": "./src/infrastructure/models/schema.prisma"
    }
}
